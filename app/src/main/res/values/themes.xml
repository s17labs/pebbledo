<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Theme.WebShell
        An edge-to-edge theme that gets out of the way
        and lets your web app control all visual styling.

        Key attributes:
        - windowBackground: black fallback; MainActivity overrides it with
          the persisted theme color before first draw (no theme flash)
        - statusBarColor / navigationBarColor: transparent for edge-to-edge
        - windowActionBar: false — no native action bar (your web app is the UI)
    -->
    <style name="Theme.WebShell" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <!-- Brand accent: tints the WebView text selection handles and the
             cursor insertion-handle ("carrots") so they match the app instead
             of showing the system default color. The blinking caret color
             itself is themed per web theme via CSS caret-color. -->
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="colorControlActivated">@color/brand_accent</item>
        <item name="android:colorAccent">@color/brand_accent</item>
    </style>
</resources>
