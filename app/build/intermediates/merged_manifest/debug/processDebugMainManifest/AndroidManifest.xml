<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.s17labs.pebbledo"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!--
        Add permissions here as you need them.
        Only declare what your app actually uses.

        Common permissions:
            android.permission.INTERNET           — for loading remote URLs or making API calls
            android.permission.VIBRATE            — for NativeBridge.vibrate()
            android.permission.ACCESS_FINE_LOCATION
            android.permission.ACCESS_COARSE_LOCATION
            android.permission.CAMERA
            android.permission.POST_NOTIFICATIONS  — API 33+ for push notifications
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <permission
        android:name="com.s17labs.pebbledo.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.s17labs.pebbledo.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />
    <!--
        hardwareAccelerated MUST be true for smooth WebView rendering.
        Do not set this to false.
    -->
    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebShell" >
        <activity
            android:name="com.s17labs.pebbledo.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" >

            <!--
                configChanges: prevents Activity recreation on rotation, keyboard open, etc.
                This keeps your web app running without a reload on config changes.
                See docs/gotchas-and-tips.md for more.

                windowSoftInputMode: adjustResize makes the WebView resize when the
                keyboard appears so input fields aren't hidden behind it.
                Use adjustPan if you prefer the view to pan instead.
            -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.s17labs.pebbledo.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>